# ============================================================
# HIVI Para Restaurantes — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
#
# STATUS:
#   ✅ = já configurada no .env.local
#   ⬜ = ainda precisa ser obtida
#
# Guia completo: Contextos/SETUP_KEYS.md
# ============================================================

# ── Supabase ──────────────────────────────────── ✅ Configurado
# Painel: supabase.com/dashboard/project/SEU_PROJETO/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────── ✅ Configurado
# Painel: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# IDs dos preços — dashboard.stripe.com/products
# BRL (Brasil)
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
# EUR (Portugal)
STRIPE_PRICE_BASIC_EUR=price_...
STRIPE_PRICE_PRO_EUR=price_...

# ── UltraMSG ──────────────────────────────────── ✅ Configurado
# Painel: ultramsg.com → sua instância → API & Tokens
ULTRAMSG_INSTANCE_ID=instance...
ULTRAMSG_TOKEN=...

# ── Resend ────────────────────────────────────── ✅ Configurado
# Painel: resend.com → API Keys → Create API Key
# Domínio hivi-web.com verificado no Resend.
#
# Identidades de e-mail:
#   noreply  → disparos automáticos (onboarding, avisos). Sem inbox.
#              Respostas caem no support via reply_to.
#   support  → atendimento. ImprovMX → hiagoalmeida852@gmail.com
#   feedback → pesquisas / NPS. ImprovMX → hiagoalmeida852@gmail.com
#
RESEND_API_KEY=re_...
RESEND_FROM_NOREPLY=noreply@hivi-web.com
RESEND_FROM_SUPPORT=support@hivi-web.com
RESEND_FROM_FEEDBACK=feedback@hivi-web.com

# ── Cron / Segredos internos ──────────────────── ✅ Configurado na Vercel
# Vercel injeta automaticamente no header das chamadas de cron.
# Gerar: openssl rand -hex 32
CRON_SECRET=gere-um-segredo-aqui

# ── Google OAuth ──────────────────────────────── ✅ Configurado (sem .env)
# As credenciais Google OAuth são inseridas diretamente no Supabase:
# Supabase Dashboard → Authentication → Providers → Google
# NÃO vai para o .env.local nem para a Vercel — fica só no Supabase.
# Ver passo a passo COMPLETO em Contextos/SETUP_KEYS.md (seção 1)

# ── App ───────────────────────────────────────── ✅ Configurado na Vercel
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Segurança interna ─────────────────────────── ✅ Gerar e adicionar na Vercel
# Segredo compartilhado para chamadas internas entre rotas API (ex: WhatsApp notify)
# Gerar: openssl rand -hex 32
INTERNAL_API_SECRET=gere-um-segredo-aleatorio-forte-aqui
