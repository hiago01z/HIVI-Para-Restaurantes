# ============================================================
# HIVI Para Restaurantes — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ID do plano Stripe — Plano Básico R$ 59,99/mês
STRIPE_PRICE_BASIC=price_...

# Resend (e-mails transacionais)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@hivi.com.br

# UltraMSG (WhatsApp automático)
ULTRAMSG_INSTANCE_ID=sua-instancia-id
ULTRAMSG_TOKEN=seu-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
